generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model books {
  id           Int       @id @default(autoincrement())
  title        String    @db.VarChar(255)
  author       String    @db.VarChar(255)
  user_id      Int
  created_at   DateTime? @default(now()) @db.DateTime(0)
  service      String    @db.VarChar(100)
  image        String    @db.VarChar(500)
  publisher    String?   @db.VarChar(255)
  order_date   DateTime? @db.Date
  status       String?   @db.VarChar(100)
  progress     String?   @db.VarChar(10)
  expired_at   String?   @db.VarChar(50)
  price        String?   @db.VarChar(50)
  url          String?   @db.VarChar(500)
  usage_period String?   @db.VarChar(100)
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "books_ibfk_1")

  @@index([user_id], map: "fk_user")
}

model ebook_accounts {
  id               Int       @id @default(autoincrement())
  user_id          Int
  service          String    @db.VarChar(50)
  login_id         String?   @db.VarChar(100)
  login_password   String?   @db.VarChar(255)
  access_token     String?   @db.Text
  refresh_token    String?   @db.Text
  token_expires_at DateTime? @db.DateTime(0)
  created_at       DateTime? @default(now()) @db.DateTime(0)
  users            users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "ebook_accounts_ibfk_1")

  @@unique([user_id, service], map: "unique_user_service")
}

model users {
  id               Int              @id @default(autoincrement())
  name             String?          @db.VarChar(100)
  nickname         String?          @db.VarChar(100)
  email            String?          @unique(map: "email") @db.VarChar(255)
  password         String?          @db.VarChar(255)
  created_at       DateTime?        @default(now()) @db.DateTime(0)
  provider         String?          @db.VarChar(50)
  provider_id      String?          @unique(map: "provider_id_UNIQUE") @db.VarChar(100)
  access_token     String?          @db.Text
  refresh_token    String?          @db.Text
  token_expires_at DateTime?        @db.DateTime(0)
  books            books[]
  ebook_accounts   ebook_accounts[]
}
