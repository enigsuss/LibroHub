{
  "manifest_version": 3,
  "name": "LibroHub Extension",
  "version": "1.0",
  "permissions": ["storage", "identity", "activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "LibroHub"
  }
}